{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // node16 (y no el clásico "node") porque @apollo/server publica sus
    // submódulos con el campo "exports" del package.json, que la resolución
    // antigua no sabe leer: sin esto, `@apollo/server/express4` no compila.
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
